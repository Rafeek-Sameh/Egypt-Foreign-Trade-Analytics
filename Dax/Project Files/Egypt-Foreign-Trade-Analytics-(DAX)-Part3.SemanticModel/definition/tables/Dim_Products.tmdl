	partition Dim_Products = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("D:\Career\Data Analysis\DEPI\Team Project\Tables\Dim_Products.xlsx"), null, true),
				    Dim_Products_Sheet = Source{[Item="Dim_Products",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Dim_Products_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Product_ID", type text}, {"HS_Code", Int64.Type}, {"Product_Name", type text}, {"Product_Category", type text}, {"Sector", type text}, {"Unit", type text}, {"Supply_Chain_Stage", type text}, {"Value_Chain_Group", type text}, {"Industry_Complexity", type text}, {"Estimated_CapEx_Tier", type text}, {"Product_Essentiality", type text}, {"Local_Raw_Material", type text}, {"Localization_Priority", type text}, {"Commodity_Trade_Class", type text}}),
				    Custom1 = Table.TransformColumns(#"Changed Type", {{"HS_Code", each Text.PadStart(Text.From(_), 6, "0"), type text}}),
				    #"Added Priority Sort" = Table.AddColumn(Custom1, "Localization_Priority_Sort", each let p = [Localization_Priority] in if p = null then 4 else if Text.Contains(p, "High", Comparer.OrdinalIgnoreCase) then 1 else if Text.Contains(p, "Medium", Comparer.OrdinalIgnoreCase) then 2 else if Text.Contains(p, "Low", Comparer.OrdinalIgnoreCase) then 3 else 4, Int64.Type)
				in
				    #"Added Priority Sort"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

