	measure 'Factory Label' =
			
			"$" & IF([Savings per Factory (M USD)] >= 1000, FORMAT([Savings per Factory (M USD)] / 1000, "#,0.0") & "bn", FORMAT([Savings per Factory (M USD)], "#,0.0") & "M") & " saved per factory"
		isHidden
		displayFolder: Trade Flow
