		lineageTag: 5db85b98-7997-42b4-8757-9419196788bc

	measure 'Imports YoY Label' =
			
			VAR y = MAX(Dim_Date[Year])
			VAR v = CALCULATE([Imports YoY %], Dim_Date[Year] = y)
			RETURN IF(ISBLANK(v), "-", IF(v >= 0, "▲ ", "▼ ") & FORMAT(ABS(v), "0.0%") & " (" & y & " vs " & (y - 1) & ")")
		isHidden
		displayFolder: Trade Flow
		lineageTag: a4530c4d-33db-4d5d-8f34-1be433647b40

	measure 'Exports YoY Label' =
			
			VAR y = MAX(Dim_Date[Year])
			VAR v = CALCULATE([Exports YoY %], Dim_Date[Year] = y)
			RETURN IF(ISBLANK(v), "-", IF(v >= 0, "▲ ", "▼ ") & FORMAT(ABS(v), "0.0%") & " (" & y & " vs " & (y - 1) & ")")
		isHidden
		displayFolder: Trade Flow
		lineageTag: 7fdc3618-6d2e-4d65-99cb-39b5696c5ba6

	measure 'Trade Position' = IF([Trade Balance] < 0, "Trade Deficit", "Trade Surplus")
		isHidden
		displayFolder: Trade Flow
		lineageTag: 27654ca3-ad37-400f-b391-0de39f060ba5

	measure 'Trade Balance Color' = IF([Trade Balance] < 0, "#C0392B", "#1E8449")
