	/// Average partner global demand in millions of USD. A relative index, not Egypt trade.
	measure 'Partner Market Size Index' =
			
			DIVIDE(AVERAGE(Fact_Trade_Transactions[Partner Global Demand USD]), 1000000)
		formatString: #,0.0
		displayFolder: Partners & Ports
