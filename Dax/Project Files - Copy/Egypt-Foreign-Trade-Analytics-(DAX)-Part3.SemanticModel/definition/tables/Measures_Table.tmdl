	/// Import value multiplied by the partner country tariff rate. An estimate, not actual customs collection.
	measure 'Estimated Tariff Revenue USD' = SUMX( FILTER(Fact_Trade_Transactions, Fact_Trade_Transactions[Trade Flow] = "Import"), Fact_Trade_Transactions[Total Value USD]* RELATED(Dim_Countries[Tariff Rate Pct]) / 100 )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Partners & Ports
		lineageTag: 30a3da0b-f448-4f26-8961-496cde78d8c9

	measure 'Port Share %' = DIVIDE( [Total Trade Volume], CALCULATE([Total Trade Volume], ALL(Dim_Ports)) )
		formatString: 0.0%
		isHidden
		displayFolder: Partners & Ports
