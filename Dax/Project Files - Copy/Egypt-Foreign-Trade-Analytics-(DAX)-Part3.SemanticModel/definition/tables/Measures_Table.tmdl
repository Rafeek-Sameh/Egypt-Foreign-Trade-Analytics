	measure 'Local Raw Material Imports USD' = CALCULATE( [Total Imports USD], Dim_Products[Local Raw Material] = "Yes" )
		formatString: \$#,0;-\$#,0;\$#,0
		isHidden
		displayFolder: Partners & Ports
		lineageTag: 62eb3a99-d8e7-4772-ab62-06a9ba453e9a

	measure 'High Localization Priority Imports USD' = CALCULATE( [Total Imports USD], Dim_Products[Localization Priority] = "High Priority" )
		formatString: \$#,0;-\$#,0;\$#,0
