	measure 'Weighted Capacity Gap %' =
			
			DIVIDE(
			    SUMX(
			        Dim_Industrial_Opportunity,
			        Dim_Industrial_Opportunity[Local Capacity Gap Pct]
			            * Dim_Industrial_Opportunity[Annual Import Avg M USD]
			    ),
			    SUM(Dim_Industrial_Opportunity[Annual Import Avg M USD])
			)/ 100
		formatString: 0.0%
		isHidden
		displayFolder: Import Substitution
		lineageTag: 46a8cf79-a31d-4cf0-97ed-2f7c97a9950b

	/// Average Import Substitution Score (0-100). Higher = stronger case for localizing the product.
	measure 'Avg Substitution Score' = AVERAGE(Dim_Industrial_Opportunity[Import Substitution Score])
		formatString: 0.0
