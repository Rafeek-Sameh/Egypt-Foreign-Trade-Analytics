		lineageTag: c136be4b-7cf6-4d73-b5d4-ea15976657d7

	/// Share of total target FX savings that comes from products eligible for the Golden License.
	measure 'Golden License Savings %' =
			
			DIVIDE([Golden License Savings (M USD)], [Target FX Savings (M USD)])
		formatString: 0.0%
		displayFolder: Import Substitution
		lineageTag: ba786b2f-9c38-4c3c-8990-90ce99311e8f

	measure 'Exported Raw & Intermediate (M USD)' =
			
			CALCULATE(
			    [Total Exports (M USD)],
			    Dim_Products[Supply Chain Stage] IN {"Raw Material", "Intermediate Good"}
			)
		formatString: #,0.0
		displayFolder: Import Substitution
		lineageTag: 265c4fcb-4176-4132-8905-dcc43eb5a001

	measure 'Imported Finished Goods (M USD)' =
			
			CALCULATE(
			    [Total Imports (M USD)],
