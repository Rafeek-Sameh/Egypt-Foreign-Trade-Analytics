	/// Compound annual growth rate of imports, 2021 to 2025 (fixed years, ignores the Year slicer).
	measure 'Imports CAGR 2021-2025' = VAR _first = CALCULATE([Total Imports USD], Dim_Date[Year] = 2021) VAR _last  = CALCULATE([Total Imports USD], Dim_Date[Year] = 2025) RETURN  IF(_first > 0 && _last > 0, DIVIDE(_last, _first) ^ (1 / 4) - 1)
		formatString: 0.0%
		displayFolder: Partners & Ports
		lineageTag: e131c354-4763-434c-a9ab-a5ccf883db23

