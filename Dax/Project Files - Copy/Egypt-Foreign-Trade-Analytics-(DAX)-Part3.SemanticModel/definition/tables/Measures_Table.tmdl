		lineageTag: 6df3c447-a9a4-4ad8-b91d-c6c07d576064

	measure 'Import-Heavy Products' = CALCULATE(  DISTINCTCOUNT(Dim_Products[Product_ID]),  Dim_Products[Commodity Trade Class] = "Import-Heavy" )
		formatString: #,0
