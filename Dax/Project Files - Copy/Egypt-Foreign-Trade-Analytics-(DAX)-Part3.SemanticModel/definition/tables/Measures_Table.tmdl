	/// Average Revealed Comparative Advantage. Above 1 means Egypt exports the product more intensively than the world average.
	measure 'Avg Export RCA' = AVERAGE(Dim_Industrial_Opportunity[Export RCA Index])
		formatString: 0.00
		displayFolder: Export Opportunities
		lineageTag: 3e879263-47f0-4f4a-aad3-41187cbd7f70

	/// Number of products with Export RCA Index above 1 (Egypt has a comparative advantage).
	measure 'Export Advantage Products' = CALCULATE(    COUNTROWS(Dim_Industrial_Opportunity),    Dim_Industrial_Opportunity[Export RCA Index] > 1)
		formatString: #,0
		displayFolder: Export Opportunities
		lineageTag: 6526d24b-37ca-410e-8843-a04aae762b7e

	measure 'Avg Export Rebate %' = ```
			
			    AVERAGE(Dim_Industrial_Opportunity[Export Rebate Incentive Pct]) / 100
			```
		formatString: 0.0%
		displayFolder: Export Opportunities
		lineageTag: 05b3eb52-cfd1-4887-abbe-459897cbdc01

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Export Rebate Value USD' = SUMX(    FILTER(Fact_Trade_Transactions, Fact_Trade_Transactions[Trade Flow] = "Export"),    Fact_Trade_Transactions[Total Value USD]        * RELATED(Dim_Industrial_Opportunity[Export Rebate Incentive Pct]) / 100)
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Export Opportunities
		lineageTag: c05cab9a-8249-4ad9-bef7-2f71aebabd27

	/// Avg Export RCA x (1 + avg rebate %). Shown only when RCA > 1.
	measure 'Export Opportunity Score' =
			
			VAR _rca = [Avg Export RCA]
			VAR _rebate = [Avg Export Rebate %]
			RETURN
			    IF(_rca > 1, _rca * (1 + _rebate), BLANK())
		formatString: 0.00
		displayFolder: Export Opportunities
		lineageTag: 14bfbcff-e347-4a25-8f01-26a52c8ed946

