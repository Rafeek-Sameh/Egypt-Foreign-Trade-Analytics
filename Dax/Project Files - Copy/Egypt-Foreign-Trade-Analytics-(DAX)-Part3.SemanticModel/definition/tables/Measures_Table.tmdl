		displayFolder: Partners & Ports
		lineageTag: c21fd9bd-6e4e-4c55-9a27-4ea8a26cad51

	/// Share of total imports (USD) coming from products classified as Strategic / Essential.
	measure 'Strategic Imports Share %' = DIVIDE( CALCULATE([Total Imports USD], Dim_Products[Product Essentiality] = "Strategic / Essential"), [Total Imports USD] )
		formatString: 0.0%
		displayFolder: Partners & Ports
		lineageTag: 59a44a9e-a22c-4c0b-97f6-780e202c4cce

	measure 'Export Market Share of Partner Demand %' =
			
			VAR _pairs =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            FILTER(Fact_Trade_Transactions, Fact_Trade_Transactions[Trade Flow] = "Export"),
			            Dim_Countries[Country_ID],
			            Dim_Products[Product_ID]
			        ),
			        "@demand",
			        CALCULATE(
			            AVERAGE(Fact_Trade_Transactions[Partner Global Demand USD]),
			            Fact_Trade_Transactions[Trade Flow] = "Export"
			        )
			    )
			VAR _demand = SUMX(_pairs, [@demand])
			VAR _years = DISTINCTCOUNT(Dim_Date[Year])
			RETURN
			    DIVIDE(DIVIDE([Total Exports USD], _years), _demand)
		formatString: 0.0%
		isHidden
		displayFolder: Partners & Ports
		lineageTag: 3ef75ce3-1db0-4380-9133-e0b5cf2341a2

	measure 'Imports per Job (M USD)' = DIVIDE([Annual Import Baseline (M USD)], [Total New Jobs])
		formatString: #,0.00
		isHidden
		displayFolder: Partners & Ports
		lineageTag: 159e10b8-468c-491f-b8cd-ec88093e93e9

	measure 'Trade Balance PY' = CALCULATE([Trade Balance], SAMEPERIODLASTYEAR(Dim_Date[Date]))
		formatString: \$#,0;-\$#,0;\$#,0
		isHidden
		displayFolder: Comparisons
		lineageTag: 4ab7a802-e0b0-49e3-87e0-ce05e5d093d5

	measure 'Trade Balance YoY Change' = [Trade Balance] - [Trade Balance PY]
		formatString: \$#,0;-\$#,0;\$#,0
		isHidden
		displayFolder: Comparisons
		lineageTag: 8f7dca91-e099-4a2d-8642-e973c5f5c14e

	/// Compound annual growth rate of exports, 2021 to 2025 (fixed years, ignores the Year slicer).
	measure 'Exports CAGR 2021-2025' =
			
			VAR _first = CALCULATE([Total Exports USD], Dim_Date[Year] = 2021)
			VAR _last  = CALCULATE([Total Exports USD], Dim_Date[Year] = 2025)
			RETURN
			    IF(_first > 0 && _last > 0, DIVIDE(_last, _first) ^ (1 / 4) - 1)
		formatString: 0.0%
		displayFolder: Partners & Ports
		lineageTag: ca31c05f-e4e7-474e-8489-95006a40a27b

	measure 'Imports QoQ %' =
			
			VAR _prev =
			    CALCULATE([Total Imports USD], DATEADD(Dim_Date[Date], -1, QUARTER))
			RETURN
			    DIVIDE([Total Imports USD] - _prev, _prev)
		formatString: 0.0%
		isHidden
		displayFolder: Comparisons
		lineageTag: c9177a12-04e5-4d20-b060-ce226a921f60

	/// Weighted score (0-100): 40% normalized FX savings + 30% local capacity gap + 30% substitution score.
	measure 'Priority Score' =
			
			VAR _score = AVERAGE(Dim_Industrial_Opportunity[Import Substitution Score])
			VAR _gap   = AVERAGE(Dim_Industrial_Opportunity[Local Capacity Gap Pct])
			VAR _maxSav =
			    CALCULATE(
			        MAX(Dim_Industrial_Opportunity[Target Annual FX Savings M USD]),
			        ALL(Dim_Industrial_Opportunity)
			    )
			VAR _sav =
			    DIVIDE(
			        AVERAGE(Dim_Industrial_Opportunity[Target Annual FX Savings M USD]),
			        _maxSav
			    ) * 100
			RETURN
			    0.4 * _sav + 0.3 * _gap + 0.3 * _score
		formatString: 0.0
		displayFolder: Opportunity Priority
		lineageTag: c26ccf6b-96ec-4ce9-9cff-71bfa0dd93ee

	measure 'Savings per Factory (M USD)' = DIVIDE([Target FX Savings (M USD)], [Total Required Factories])
		formatString: #,0.0
		displayFolder: Opportunity Priority
		lineageTag: 3fad0e27-ef00-4b8f-bb68-a15d1aa3cae7

	/// Running share of total target FX savings when products are ranked from highest to lowest savings (Pareto).
	measure 'Cumulative Savings %' =
			
			VAR _cur = [Target FX Savings (M USD)]
			VAR _all = ALL(Dim_Products[Product Name])
			VAR _cum =
			    SUMX(
			        FILTER(_all, [Target FX Savings (M USD)] >= _cur),
			        [Target FX Savings (M USD)]
			    )
			VAR _total = SUMX(_all, [Target FX Savings (M USD)])
			RETURN
			    DIVIDE(_cum, _total)
		formatString: 0.0%
		displayFolder: Opportunity Priority
		lineageTag: 1a9fd0b5-71be-4d41-b746-75e0cde69be4

	measure 'Import Share of Trade %' = DIVIDE([Total Imports USD], [Total Trade Volume])
		formatString: 0.0%
		isHidden
		displayFolder: Data Quality
		lineageTag: 27d0418f-c6b8-4c24-a9d4-4922fd4e3d1a

	measure 'Export Share of Trade %' = DIVIDE([Total Exports USD], [Total Trade Volume])
		formatString: 0.0%
		isHidden
		displayFolder: Data Quality
		lineageTag: 7d24f435-0873-4b16-8c69-a067df16d7fd

	measure 'Port Share by Transactions %' =
			
			DIVIDE(
			    [Transactions Count],
			    CALCULATE([Transactions Count], ALL(Dim_Ports))
			)
		formatString: 0.0%
		displayFolder: Partners & Ports
		lineageTag: cea3f012-6e6f-4da8-a2e0-429519314efc

	measure 'Value Calc Error Rows' =
			
			COUNTROWS(
			    FILTER(
			        Fact_Trade_Transactions,
			        ABS(
			            Fact_Trade_Transactions[Total Value USD]
			            - Fact_Trade_Transactions[Quantity] * Fact_Trade_Transactions[Unit Price USD]
			        ) > 1
			    )
			) + 0
		formatString: #,0
		isHidden
		displayFolder: Data Quality
		lineageTag: ae783dbd-aace-43b8-a6e8-1bf5b5e2d0f8

	measure 'Anomaly Products' =
			
			CALCULATE(
			    DISTINCTCOUNT(Dim_Products[Product_ID]),
			    Dim_Products[Commodity Trade Class] = "Anomaly / Needs Investigation"
			)
		formatString: #,0
		isHidden
		displayFolder: Partners & Ports
		lineageTag: 0db02d58-d37e-4e46-a8aa-09b250750800

	measure 'Country Title' = "Country Profile: " & SELECTEDVALUE(Dim_Countries[Partner Country], "All Countries")
		isHidden
